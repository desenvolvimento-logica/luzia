# Copie para .env.local e preencha com valores do projeto Supabase ISOLADO de desenvolvimento.
# Nunca versionar valores. Valores de produção ficam no painel da Vercel / cofre.

# Projeto Supabase compartilhado (mesmos nomes de variáveis do Controle de Vencimentos LG e do HelpDesk GC)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta (ignora RLS): somente servidor, só nos adaptadores de atividades. Nunca usar prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Origem pública deste hub (usada em redirects OAuth), ex.: https://hub-staging.exemplo.com.br
LUZIA_HUB_ORIGIN=

# Origens aprovadas das aplicações integradas, separadas por vírgula (somente https).
# Também definem o frame-src da CSP (lidas no build).
LUZIA_APP_ALLOWED_ORIGINS=

# Somente desenvolvimento: aceita http://localhost e http://127.0.0.1 como origem de aplicação.
# Ignorado quando NODE_ENV=production.
LUZIA_ALLOW_LOCAL_APPS=false

# Bucket público de ícones (legado: app-icons)
LUZIA_ICON_BUCKET=app-icons
